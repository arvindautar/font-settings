# Font settings applied by apply.sh. Edit these, then run ./install.sh again.

# --- GNOME (gsettings org.gnome.desktop.interface) ---
GNOME_FONT_NAME="Adwaita Sans 11"
GNOME_DOCUMENT_FONT_NAME="Adwaita Sans 12"
GNOME_MONOSPACE_FONT_NAME="JetBrains Mono 11"
GNOME_FONT_ANTIALIASING="rgba"     # none | grayscale | rgba
GNOME_FONT_HINTING="slight"        # none | slight | medium | full
GNOME_FONT_RGBA_ORDER="rgb"        # rgb | bgr | vrgb | vbgr
# Text-only scaling. 1.25 makes text larger on dense (~160 DPI) laptop panels.
GNOME_TEXT_SCALING_FACTOR="1.0"

# --- Brave (brave://settings/fonts) ---
BRAVE_FONT_STANDARD="Adwaita Sans"
BRAVE_FONT_SANS="Adwaita Sans"
BRAVE_FONT_SERIF="Noto Serif"
BRAVE_FONT_FIXED="JetBrains Mono"
